# .env.example — All environment variables required by LinkAuto
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control — it is already in .gitignore.
#
# Usage:
#   cp .env.example .env.local
#   # Then edit .env.local with your actual values

# ─── Firebase ─────────────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── LinkedIn OAuth2 ──────────────────────────────────────────────────────────
# From https://www.linkedin.com/developers/apps → Your App → Auth tab
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Full callback URL registered in LinkedIn app settings:
# e.g. http://localhost:3000/api/auth/linkedin/callback  (dev)
#      https://your-app.vercel.app/api/auth/linkedin/callback  (prod)
LINKEDIN_REDIRECT_URI=
# Optional: LinkedIn Organization ID for Corporate segment posting
# urn:li:organization:XXXXXXX → put only the numeric ID here
LINKEDIN_ORGANIZATION_ID=

# ─── OpenRouter (AI — Research + Generation) ──────────────────────────────────
# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used by server-side fetches (cron worker → engagement API)
# Dev:  http://localhost:3000
# Prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin Panel ─────────────────────────────────────────────────────────────
# Comma-separated list of Firebase Auth emails that can access /admin
# e.g. admin@yourdomain.com,otherperson@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=

# Firebase Admin SDK service account (for cron worker + admin panel)
# From Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste the ENTIRE JSON as a single minified line (no newlines)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Cron Security (optional) ─────────────────────────────────────────────────
# Set this to lock the /api/cron/publish-due endpoint to Vercel Cron only.
# Must match the Authorization: Bearer <secret> header sent by Vercel.
# Leave empty in local dev (no auth check performed when unset).
CRON_SECRET=

# ─── Team Invite Signing (REQUIRED for team feature) ─────────────────────────
# HMAC secret used to sign team-invite tokens. Set to any high-entropy random
# string (e.g. `openssl rand -hex 32`). Rotating this value invalidates every
# outstanding pending invite. Must be set in every environment that exposes
# /api/team/* routes — without it, invite creation/preview/accept all 500.
INVITE_SIGNING_SECRET=

# ─── fal.ai (Image Generation) ────────────────────────────────────────────────
# From https://fal.ai/dashboard/keys
# Used for AI image generation on post preview
FAL_API_KEY=

# ─── Google Gemini (fallback AI — optional) ───────────────────────────────────
# Only used if OpenRouter is unavailable. From https://aistudio.google.com/apikey
GEMINI_API_KEY=
